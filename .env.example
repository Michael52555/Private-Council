GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=

# Optional. Changing the exact model name selects a separate profile cache.
# RESTAURANT_PROFILE_MODEL=gpt-5-mini

# Central restaurant cache. Defaults to .data/restaurant-cache.sqlite.
# Set this to a persistent volume path in hosted environments.
# RESTAURANT_CACHE_DB_PATH=/absolute/persistent/path/restaurant-cache.sqlite

