GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=

# Central restaurant cache. Defaults to .data/restaurant-cache.sqlite.
# Set this to a persistent volume path in hosted environments.
# RESTAURANT_CACHE_DB_PATH=/absolute/persistent/path/restaurant-cache.sqlite

# Optional in local development when Chrome/Chromium is installed.
# Required in hosted environments for Google Maps and JavaScript-only menus.
# PLAYWRIGHT_WS_ENDPOINT=wss://your-browser-service.example
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/absolute/path/to/chromium
